<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer. See backup_rules.xml for why security.xml is excluded. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="security.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="security.xml" />
    </device-transfer>
</data-extraction-rules>
