rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Everything a user owns lives under users/{uid}/..., so one rule covers
    // entries, quick notes and anything added later. Nothing else is readable.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
